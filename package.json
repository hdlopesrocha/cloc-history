{
  "name": "cloc-history",
  "version": "1.0.0",
  "description": "Commit-by-commit line-of-code history for Git repositories, with a Vue dashboard, language-aware charts, and CSV export.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "cloc-history": "./scripts/cloc-history.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "scan": "node scripts/cloc-history.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server/index.mjs && node --check server/scanner.mjs && node --check server/demo.mjs && npm test && npm run build"
  },
  "keywords": [
    "cloc",
    "git",
    "lines-of-code",
    "vue",
    "codebase",
    "visualization"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "express": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
